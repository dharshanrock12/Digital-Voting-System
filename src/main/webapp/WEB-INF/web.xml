<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
         http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

    <display-name>Digital Voting System</display-name>
    <description>DVS — Dharshan Sathish Kumar | Reg: 3122255002029</description>

    <!-- Welcome / Root page -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session timeout: 30 minutes -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ============================================================
         Explicit Servlet Mappings
         (Required for Tomcat 7 — annotation scanning is unreliable)
         ============================================================ -->

    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.dvs.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.dvs.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Admin Servlet -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.dvs.servlet.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin/*</url-pattern>
    </servlet-mapping>

    <!-- Officer Servlet -->
    <servlet>
        <servlet-name>OfficerServlet</servlet-name>
        <servlet-class>com.dvs.servlet.OfficerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OfficerServlet</servlet-name>
        <url-pattern>/officer/*</url-pattern>
    </servlet-mapping>

    <!-- Voter Servlet -->
    <servlet>
        <servlet-name>VoterServlet</servlet-name>
        <servlet-class>com.dvs.servlet.VoterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VoterServlet</servlet-name>
        <url-pattern>/voter/*</url-pattern>
    </servlet-mapping>

    <!-- 404 Error Page -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>

    <!-- 500 Error Page -->
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>

</web-app>
